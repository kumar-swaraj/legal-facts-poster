# ==============================================================================
# Automated Legal Insights Poster Configuration
# ==============================================================================

# --- 1. Target Platform Credentials (Required) ---
# Your login credentials for the target legal community platform
MY_SITE_USERNAME=your_email_or_username
MY_SITE_PASSWORD=your_password
BASE_URL=https://your-platform-domain.com

# --- 2. AI Intelligence Provider (Required) ---
# Supported providers:
#   - gemini      : Google Gemini (default, free tier at https://aistudio.google.com/)
#   - openai      : OpenAI (GPT-4o-mini, GPT-4o)
#   - claude      : Anthropic Claude (claude-3-5-haiku, claude-3-7-sonnet)
#   - deepseek    : DeepSeek (deepseek-chat)
#   - grok        : xAI Grok (grok-2-latest)
#   - kimi        : Moonshot AI / Kimi (moonshot-v1-8k)
#   - groq        : Groq (llama-3.3-70b-versatile, ultra fast)
#   - openrouter  : OpenRouter (universal access to all models)
#   - custom      : Any OpenAI-compatible local or proxy endpoint (Ollama, vLLM)
AI_PROVIDER=gemini

# Your API key for the chosen provider:
AI_API_KEY=your_api_key_here

# Alternatively, you can use provider-specific environment variable names:
# GEMINI_API_KEY=your_gemini_key
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key
# DEEPSEEK_API_KEY=your_deepseek_key
# GROK_API_KEY=your_grok_key
# KIMI_API_KEY=your_kimi_key
# GROQ_API_KEY=your_groq_key
# OPENROUTER_API_KEY=your_openrouter_key

# --- Optional AI Overrides ---
# Override model name (leave empty to use provider default):
# AI_MODEL=gemini-2.5-flash

# Custom OpenAI-compatible endpoint URL (required only for 'custom'):
# AI_BASE_URL=http://localhost:11434/v1

# --- 3. Browser Automation Settings ---
# Run browser in headless mode (true = background/invisible, false = visible window)
HEADLESS=false

# File path to store authenticated session cookies (skips re-login on future runs)
SESSION_FILE=session.json

# --- 4. Scheduling & Interval Settings ---
# Interval in hours between automated posts (e.g., 4.0 or 0.5)
POST_INTERVAL_HOURS=4.0

# Add random delay jitter (e.g. +/- 5-10 minutes) to humanize posting intervals
ENABLE_JITTER=true
JITTER_MAX_MINUTES=10

# --- 5. Reliability & Retries ---
# Number of retry attempts on temporary network failure before waiting for next schedule
MAX_RETRIES=2
RETRY_DELAY_SECONDS=60

# History file to track posted topics and prevent duplicates
HISTORY_FILE=posted_history.txt

# --- 6. Observability & Alerts (Optional) ---
# Discord or generic webhook URL:
# WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# Dedicated Microsoft Teams webhook (Workflows or Office 365 connector):
# TEAMS_WEBHOOK_URL=https://prod-XX.logic.azure.com/workflows/...
# Or Telegram credentials:
# TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
# TELEGRAM_CHAT_ID=987654321
# Notification level: "all" (every post + errors) or "failures_only" (errors only)
NOTIFY_ON=all
# Passive dead-man's switch / liveness heartbeat URL (Healthchecks.io / Uptime Kuma)
# HEALTHCHECK_URL=https://hc-ping.com/YOUR-UUID